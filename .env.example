# ==========================================
# VoltHabit Desktop Widget Configuration
# ==========================================

# Required: The Firebase User ID whose habits are synced (users/{userId}/habits)
FIREBASE_USER_ID=your_firebase_user_id_here

# Firebase Project & Named Database (pre-configured for VoltHabit)
FIREBASE_PROJECT_ID=gen-lang-client-0880363053
FIRESTORE_DATABASE_ID=ai-studio-android-volthabi-49d89ac7-d707-4fd5-8572-478243a64893

# ==========================================
# Authentication Option 1: Service Account (Recommended for Desktop)
# Path to your Firebase service account JSON key file, or raw JSON
# ==========================================
FIREBASE_SERVICE_ACCOUNT_KEY=serviceAccountKey.json

# ==========================================
# Authentication Option 2: Firebase Web Auth (Optional)
# If using Firebase Web API Key and user account
# ==========================================
# FIREBASE_API_KEY=AIzaSy...
# FIREBASE_USER_EMAIL=you@example.com
# FIREBASE_USER_PASSWORD=your_password
